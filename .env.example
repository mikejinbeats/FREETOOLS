# ============================================================
# FREETOOLS SECURITY ENVIRONMENT VARIABLES TEMPLATE
# DO NOT ADD REAL SECRET KEYS HERE! USE FOR LOCAL REFERENCE ONLY.
# ============================================================

# Cloudflare Pages / Local Environment
PORT=8000
NODE_ENV=production

# Supabase Credentials (Client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Private Keys (SERVER-SIDE ONLY - NEVER EXPOSE IN FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Third-Party API Keys (SERVER-SIDE ONLY)
RESEND_API_KEY=re_your_resend_api_key_here
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
